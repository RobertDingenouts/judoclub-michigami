generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String?
  name               String?
  clerkUserId        String?            @unique
  imageUrl           String?
  role               Role               @default(MEMBER)
  currentBelt        BeltLevel?
  totalPoints        Int                @default(0)
  weeklyPoints       Int                @default(0)
  joinDate           DateTime?
  is_active          Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  courseProgress     CourseProgress[]
  diplomas           Diploma[]
  examAttempts       ExamAttempt[]
  leaderboardEntries LeaderboardEntry[]
  member             Member?

  @@index([email])
  @@index([clerkUserId])
}

model Member {
  id                    String             @id @default(cuid())
  userId                String             @unique
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?
  currentBelt           BeltLevel?
  joinDate              DateTime           @default(now())
  isActive              Boolean            @default(true)
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  courseProgress        CourseProgress[]
  diplomas              Diploma[]
  examAttempts          ExamAttempt[]
  leaderboardEntries    LeaderboardEntry[]
  attendance            LessonAttendance[]
  user                  User               @relation(fields: [userId], references: [id])

  @@index([lastName, firstName])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  locationUrl String?
  time        String?
  type        EventType
  isCancelled Boolean   @default(false)
  emoji       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
}

model LessonAttendance {
  id        String   @id @default(cuid())
  memberId  String
  eventId   String?
  date      DateTime
  notes     String?
  points    Int      @default(1)
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id])

  @@unique([memberId, date])
  @@index([date])
}

model Technique {
  id           String  @id @default(cuid())
  nameJa       String
  nameNl       String
  category     String
  mainCategory String
  forbidden    Boolean @default(false)
  description  String?
  videoUrl     String?
  imageUrl     String?
  order        Int

  @@unique([nameJa, category])
}

model ExamAttempt {
  id           String       @id @default(cuid())
  memberId     String
  userId       String
  beltLevel    BeltLevel
  status       ExamStatus   @default(SCHEDULED)
  examDate     DateTime?
  examiner     String?
  overallScore Int?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  diploma      Diploma?
  member       Member       @relation(fields: [memberId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  results      ExamResult[]

  @@index([memberId, beltLevel])
  @@index([userId, beltLevel])
  @@index([examDate])
}

model ExamResult {
  id            String      @id @default(cuid())
  attemptId     String
  techniqueId   String?
  techniqueName String
  category      String?
  passed        Boolean
  score         Int?
  feedback      String?
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@index([techniqueId])
}

model Diploma {
  id               String       @id @default(cuid())
  type             DiplomaType
  title            String
  description      String?
  recipientId      String
  userId           String
  beltLevel        BeltLevel?
  courseName       String?
  examAttemptId    String?      @unique
  awardedAt        DateTime     @default(now())
  verificationCode String       @unique
  imageUrl         String?
  createdAt        DateTime     @default(now())
  examAttempt      ExamAttempt? @relation(fields: [examAttemptId], references: [id])
  member           Member       @relation(fields: [recipientId], references: [id])
  user             User         @relation(fields: [userId], references: [id])

  @@index([recipientId])
  @@index([userId])
  @@index([verificationCode])
}

model CourseProgress {
  id               String    @id @default(cuid())
  memberId         String
  userId           String
  courseName       String
  beltLevel        BeltLevel
  lessonsCompleted Int       @default(0)
  lessonsTotal     Int       @default(0)
  quizScores       Json?
  overallScore     Float     @default(0)
  isPassed         Boolean   @default(false)
  isUnlocked       Boolean   @default(true)
  wordsLearned     Int       @default(0)
  wordsTotal       Int       @default(0)
  wordsQuizScore   Float     @default(0)
  lastActivityAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  member           Member    @relation(fields: [memberId], references: [id])
  user             User      @relation(fields: [userId], references: [id])

  @@unique([userId, courseName, beltLevel])
  @@index([userId, beltLevel])
}

model LeaderboardEntry {
  id           String       @id @default(cuid())
  userId       String
  memberId     String?
  weekStart    DateTime
  points       Int
  activityType ActivityType
  referenceId  String?
  description  String?
  createdAt    DateTime     @default(now())
  member       Member?      @relation(fields: [memberId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([weekStart, points])
  @@index([userId, weekStart])
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String
  isPublished Boolean  @default(true)
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Image {
  id        String   @id @default(cuid())
  filename  String
  url       String
  alt       String?
  category  String?
  createdAt DateTime @default(now())
}

enum Role {
  MEMBER
  PARENT
  INSTRUCTOR
  ADMIN
}

enum BeltLevel {
  WIT
  GEEL
  ORANJE
  GROEN
  BLAUW
  BRUIN_1
  BRUIN_2
  BRUIN_3
  Zwart_1
  Zwart_2
  Zwart_3
}

enum EventType {
  LESSON
  TOURNAMENT
  EXAM
  MEETING
  SPECIAL
}

enum DiplomaType {
  BELT_EXAM
  COURSE_JAPANESE
  ACHIEVEMENT
}

enum ExamStatus {
  SCHEDULED
  COMPLETED_PASSED
  COMPLETED_FAILED
  CANCELLED
}

enum ActivityType {
  COURSE_QUIZ
  EXAM_PASSED
  ATTENDANCE
  TECHNIQUE_MASTERED
  LEADERBOARD_BONUS
}
