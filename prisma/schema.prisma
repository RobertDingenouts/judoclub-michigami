generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String?
  name           String?
  imageUrl       String?
  role           Role           @default(MEMBER)
  currentBelt    BeltLevel?
  joinDate       DateTime?
  is_active      Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  courseProgress CourseProgress[]
  diplomas       Diploma[]
  examAttempts   ExamAttempt[]
  member         Member?

  @@index([email])
}

model Member {
  id                    String        @id @default(cuid())
  userId                String        @unique
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  phone2                String?
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  postalCode            String?
  city                  String?
  currentBelt           BeltLevel?
  location              String?
  joinDate              DateTime      @default(now())
  isActive              Boolean       @default(true)
  whatsappGroup         String?
  portraitRights        Boolean?
  nameMention           Boolean?
  privacyAgreed         Boolean?
  privacyAgreedAt       DateTime?
  termsAgreed           Boolean?
  termsAgreedAt         DateTime?
  remarks               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  courseProgress        CourseProgress[]
  diplomas              Diploma[]
  examAttempts          ExamAttempt[]
  user                  User          @relation(fields: [userId], references: [id])

  @@index([lastName, firstName])
  @@index([location])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  locationUrl String?
  time        String?
  type        EventType
  isCancelled Boolean   @default(false)
  emoji       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
}

model Technique {
  id           String  @id @default(cuid())
  nameJa       String
  nameNl       String
  category     String
  mainCategory String
  forbidden    Boolean @default(false)
  description  String?
  videoUrl     String?
  imageUrl     String?
  order        Int

  @@unique([nameJa, category])
}

model ExamAttempt {
  id           String       @id @default(cuid())
  memberId     String
  userId       String
  beltLevel    BeltLevel
  status       ExamStatus   @default(SCHEDULED)
  examDate     DateTime?
  examiner     String?
  overallScore Int?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  diploma      Diploma?
  member       Member       @relation(fields: [memberId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  results      ExamResult[]

  @@index([memberId, beltLevel])
  @@index([userId, beltLevel])
  @@index([examDate])
}

model ExamResult {
  id            String      @id @default(cuid())
  attemptId     String
  techniqueId   String?
  techniqueName String
  category      String?
  passed        Boolean
  score         Int?
  feedback      String?
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@index([techniqueId])
}

model Diploma {
  id               String       @id @default(cuid())
  type             DiplomaType
  title            String
  description      String?
  recipientId      String
  userId           String
  beltLevel        BeltLevel?
  courseName       String?
  examAttemptId    String?      @unique
  awardedAt        DateTime     @default(now())
  verificationCode String       @unique
  imageUrl         String?
  pdfUrl           String?
  createdAt        DateTime     @default(now())
  examAttempt      ExamAttempt? @relation(fields: [examAttemptId], references: [id])
  member           Member       @relation(fields: [recipientId], references: [id])
  user             User         @relation(fields: [userId], references: [id])

  @@index([recipientId])
  @@index([userId])
  @@index([verificationCode])
}

model CourseProgress {
  id               String    @id @default(cuid())
  memberId         String
  userId           String
  courseName       String
  beltLevel        BeltLevel
  lessonsCompleted Int       @default(0)
  lessonsTotal     Int       @default(0)
  quizScores       Json?
  overallScore     Float     @default(0)
  isPassed         Boolean   @default(false)
  isUnlocked       Boolean   @default(true)
  wordsLearned     Int       @default(0)
  wordsTotal       Int       @default(0)
  wordsQuizScore   Float     @default(0)
  lastActivityAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  member           Member    @relation(fields: [memberId], references: [id])
  user             User      @relation(fields: [userId], references: [id])

  @@unique([userId, courseName, beltLevel])
  @@index([userId, beltLevel])
}

enum Role {
  MEMBER
  PARENT
  INSTRUCTOR
  ADMIN
}

enum BeltLevel {
  WIT
  WIT_GEEL
  GEEL
  GEEL_ORANJE
  ORANJE
  ORANJE_GROEN
  GROEN
  GROEN_BLAUW
  BLAUW
  BLAUW_BRUIN
  BRUIN
  ZWART_1
  ZWART_2
  ZWART_3
  ZWART_4
  ZWART_5
  ZWART_6
  ZWART_7
  ZWART_8
  ZWART_9
  ZWART_10
  // Legacy values - will be migrated
  BRUIN_1
  BRUIN_2
  BRUIN_3
  Zwart_1
  Zwart_2
  Zwart_3
}

enum EventType {
  LESSON
  TOURNAMENT
  EXAM
  MEETING
  SPECIAL
}

enum DiplomaType {
  BELT_EXAM
  COURSE_JAPANESE
  ACHIEVEMENT
}

enum ExamStatus {
  SCHEDULED
  COMPLETED_PASSED
  COMPLETED_FAILED
  CANCELLED
}

model MembershipApplication {
  id               String           @id @default(cuid())
  firstName        String
  lastName         String
  email            String
  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  postalCode       String?
  city             String?
  location         String
  membershipType   String
  isChild          Boolean          @default(false)
  parentName       String?
  parentEmail      String?
  parentPhone      String?
  medicalNotes     String?
  emergencyContact String?
  costAgreed       Boolean          @default(false)
  privacyAgreed    Boolean          @default(false)
  termsAgreed      Boolean          @default(false)
  portraitRights   Boolean?
  status           ApplicationStatus @default(PENDING)
  adminNotes       String?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  memberId         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}
