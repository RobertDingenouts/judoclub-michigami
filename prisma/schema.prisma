generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String?        @unique
  passwordHash     String?
  name             String?
  imageUrl         String?
  role             Role           @default(MEMBER)
  currentBelt      BeltLevel?
  joinDate         DateTime?
  is_active        Boolean        @default(true)

  // E-mailverificatie is afgeschaft (aug 2026): geen verificatielinks meer,
  // gewoon een welkomstmail. Kolommen verwijderd uit schema + DB.

  // Wachtwoord-reset
  resetToken     String?    @unique
  resetTokenExpires DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  courseProgress CourseProgress[]
  diplomas       Diploma[]
  examAttempts   ExamAttempt[]
  member         Member?
}

model Member {
  id                    String        @id @default(cuid())
  userId                String        @unique
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  phone2                String?
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  postalCode            String?
  city                  String?
  currentBelt           BeltLevel?
  location              String?
  joinDate              DateTime      @default(now())
  isActive              Boolean       @default(true)
  whatsappGroup         String?
  portraitRights        Boolean?
  nameMention           Boolean?
  privacyAgreed         Boolean?
  privacyAgreedAt       DateTime?
  termsAgreed           Boolean?
  termsAgreedAt       DateTime?
  codeOfConduct       Boolean?
  codeOfConductAt     DateTime?
  trainingGroups      Json?
  primaryGroup        String?
  remarks             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  bondsnummer           String?     @unique
  beltSince             DateTime? // wanneer lid aan huidige band/slip begon (override; anders afgeleid)
  examPrep              ExamPrep[]
  clubStatus            String      @default("LID") // LID | RESERVE | STOPPEND | GESTOPT
  isTrainer             Boolean     @default(false) // trainer/instructeur: onderaan elke les kruisbaar
  leaveDate             DateTime? // datum van uitschrijving (bij GESTOPT)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime      @updatedAt
  courseProgress        CourseProgress[]
  diplomas              Diploma[]
  examAttempts          ExamAttempt[]
  attendance            Attendance[]
  payments              Payment[]
  bondHistory           BondHistory[]
  competitions          Competition[]
  user                  User          @relation(fields: [userId], references: [id])

  @@index([lastName, firstName])
  @@index([location])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  locationUrl String?
  time        String?
  type        EventType
  isCancelled Boolean   @default(false)
  emoji       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
}

model Technique {
  id           String  @id @default(cuid())
  nameJa       String
  nameNl       String
  category     String
  mainCategory String
  forbidden    Boolean @default(false)
  description  String?
  videoUrl     String?
  imageUrl     String?
  order        Int

  @@unique([nameJa, category])
}

model ExamAttempt {
  id           String       @id @default(cuid())
  memberId     String
  userId       String
  beltLevel    BeltLevel
  status       ExamStatus   @default(SCHEDULED)
  examDate     DateTime?
  examiner     String?
  overallScore Int?
  notes        String?
  categoryResults Json?     // categoryId -> boolean (voldaan bij de examinator)
  klaar           Boolean   @default(false) // proefexamen: door examinator vrijgegeven voor examen
  sittingId    String?
  sitting      ExamSitting? @relation(fields: [sittingId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  diploma      Diploma?
  member       Member       @relation(fields: [memberId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  results      ExamResult[]

  @@index([memberId, beltLevel])
  @@index([userId, beltLevel])
  @@index([examDate])
}

model ExamSitting {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  group     String   // VRIJDAG_1E | VRIJDAG_2E | WOENSDAG | SENIOREN
  type      String   @default("EXAMEN") // PROEF (weken testen, geen slaging) | EXAMEN (officieel)
  title     String?
  examiners String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts  ExamAttempt[]

  @@unique([date, group, type])
  @@index([date])
}

// Techniek-afvinklijst per lid + doelband, persistent over weken heen (voorbereiding los van een zitting)
model ExamPrep {
  id         String   @id @default(cuid())
  memberId   String
  targetBelt String // DoelBelt-slotnaam, bv. WIT_GEEL
  checked    Json     @default("{}") // Record<string, true>, key = `${catId}|${nameJa}`
  updatedAt  DateTime @updatedAt
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, targetBelt])
}

model ExamResult {
  id            String      @id @default(cuid())
  attemptId     String
  techniqueId   String?
  techniqueName String
  category      String?
  passed        Boolean
  score         Int?
  feedback      String?
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@index([techniqueId])
}

model Diploma {
  id               String       @id @default(cuid())
  type             DiplomaType
  title            String
  description      String?
  recipientId      String
  userId           String
  beltLevel        BeltLevel?
  courseName       String?
  examAttemptId    String?      @unique
  awardedAt        DateTime     @default(now())
  verificationCode String       @unique
  imageUrl         String?
  pdfUrl           String?
  createdAt        DateTime     @default(now())
  examAttempt      ExamAttempt? @relation(fields: [examAttemptId], references: [id])
  member           Member       @relation(fields: [recipientId], references: [id])
  user             User         @relation(fields: [userId], references: [id])

  @@index([recipientId])
  @@index([userId])
  @@index([verificationCode])
}

model CourseProgress {
  id               String    @id @default(cuid())
  memberId         String
  userId           String
  courseName       String
  beltLevel        BeltLevel
  lessonsCompleted Int       @default(0)
  lessonsTotal     Int       @default(0)
  quizScores       Json?
  overallScore     Float     @default(0)
  isPassed         Boolean   @default(false)
  isUnlocked       Boolean   @default(true)
  wordsLearned     Int       @default(0)
  wordsTotal       Int       @default(0)
  wordsQuizScore   Float     @default(0)
  lastActivityAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  member           Member    @relation(fields: [memberId], references: [id])
  user             User      @relation(fields: [userId], references: [id])

  @@unique([userId, courseName, beltLevel])
  @@index([userId, beltLevel])
}

enum Role {
  MEMBER
  PARENT
  INSTRUCTOR
  ADMIN
}

enum BeltLevel {
  PAARS // startband nieuwe leden — eerste examen is voor de witte band
  WIT
  WIT_GEEL
  GEEL
  GEEL_ORANJE
  ORANJE
  ORANJE_GROEN
  GROEN
  GROEN_BLAUW
  BLAUW
  BLAUW_BRUIN
  BRUIN
  ZWART_1
  ZWART_2
  ZWART_3
  ZWART_4
  ZWART_5
  ZWART_6
  ZWART_7
  ZWART_8
  ZWART_9
  ZWART_10
  // Legacy values - will be migrated
  BRUIN_1
  BRUIN_2
  BRUIN_3
  Zwart_1
  Zwart_2
  Zwart_3
}

enum EventType {
  LESSON
  TOURNAMENT
  EXAM
  MEETING
  SPECIAL
}

enum DiplomaType {
  BELT_EXAM
  COURSE_JAPANESE
  ACHIEVEMENT
}

enum ExamStatus {
  SCHEDULED
  COMPLETED_PASSED
  COMPLETED_FAILED
  CANCELLED
}

model MembershipApplication {
  id               String           @id @default(cuid())
  firstName        String
  lastName         String
  email            String
  phone            String?
  phone2           String?
  whatsappGroup    String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  postalCode       String?
  city             String?
  location         String
  preferredGroup   String?
  isChild          Boolean          @default(false)
  parentName       String?
  parentEmail      String?
  parentPhone      String?
  medicalNotes     String?
  emergencyContact String?
  costAgreed       Boolean          @default(false)
  privacyAgreed    Boolean          @default(false)
  privacyAgreedAt  DateTime?
  termsAgreed      Boolean          @default(false)
  termsAgreedAt    DateTime?
  codeOfConduct    Boolean          @default(false)
  portraitRights   Boolean?
  nameMention      Boolean?
  status           ApplicationStatus @default(PENDING)
  adminNotes       String?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  memberId         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// Admin Dashboard 2.0 (okt 2026) — additieve tabellen, bestaande data blijft
// ============================================================================

model TrainingDay {
  id        String        @id @default(cuid())
  date      DateTime      @db.Date
  location  String        // 'STEENBERGEN' | 'OUD_VOSSEMEER'
  group     String        // 'VRIJDAG_1E' | 'VRIJDAG_2E' | 'VRIJDAG_3E' | 'WOENSDAG' | 'SENIOREN'
  cancelled Boolean       @default(false)
  activity  String?       // onderwerp/activiteit van deze les
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  attendance Attendance[]

  @@unique([date, group])
  @@index([date])
}

enum AttendanceStatus {
  AANWEZIG
  AFGEMELD
  NIET_AANWEZIG
  ZIEK
  VERZET
  VAKANTIE
  PROEFLES
}

model Attendance {
  id            String           @id @default(cuid())
  memberId      String
  trainingDayId String
  status        AttendanceStatus @default(AANWEZIG)
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  member        Member           @relation(fields: [memberId], references: [id])
  trainingDay   TrainingDay      @relation(fields: [trainingDayId], references: [id])

  @@unique([memberId, trainingDayId])
  @@index([trainingDayId])
}

model ContributionPeriod {
  id     String   @id @default(cuid())
  label  String   @unique // '2026-Q1'
  start  DateTime @db.Date
  end    DateTime @db.Date
  amount Decimal  @default(42.00) @db.Decimal(6, 2)
  payments Payment[]
}

enum PaymentStatus {
  OPEN
  BETAALD
  HERINNERING1
  HERINNERING2
  VIJGESTELD
}

model Payment {
  id            String             @id @default(cuid())
  memberId      String
  periodId      String
  amount        Decimal            @db.Decimal(6, 2)
  status        PaymentStatus      @default(OPEN)
  dueDate       DateTime?          @db.Date
  invoiceNumber String?            @unique
  items         String? // JSON: [{ omschrijving, bedrag }] — als gezet: factuurlijnen i.p.v. standaard contributielijn
  paidAt        DateTime?
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  member        Member             @relation(fields: [memberId], references: [id])
  period        ContributionPeriod @relation(fields: [periodId], references: [id])

  @@unique([memberId, periodId])
  @@index([periodId, status])
}

model BondHistory {
  id        String    @id @default(cuid())
  memberId  String
  belt      BeltLevel
  awardedAt DateTime  @db.Date
  source    String    @default("IMPORT") // IMPORT | EXAM | HAND
  member    Member    @relation(fields: [memberId], references: [id])

  @@unique([memberId, belt])
  @@index([memberId])
}

model Competition {
  id       String   @id @default(cuid())
  memberId String
  date     DateTime @db.Date
  name     String
  result   String?
  notes    String?
  member   Member   @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([date])
}

model TournamentEntry {
  id            String   @id @default(cuid())
  toernooi      String   // slug, bijv. kersttoernooi-shintai-2026
  naam          String   // voornaam + achternaam judoka
  geslacht      String   // Man | Vrouw
  leeftijd      Int
  gewicht       Float    // kg
  band          String   // bandkleur
  niveau        String   // per toernooi: Shintai A|B|C|D, Yoshi-Kwai Pre|Competitie
  geboortedatum String?  // ISO yyyy-mm-dd; verplicht bij toernooien die geboortedatum vragen
  betaald       Boolean  @default(false)
  opmerking     String?
  ingediendDoor String?  // e-mail van ingelogde inzender (optioneel)
  aangemaakt    DateTime @default(now())
  bijgewerkt    DateTime @updatedAt

  @@index([toernooi])
}

model TournamentSetup {
  id        String   @id @default(cuid())
  toernooi  String   @unique
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model InventoryItem {
  id         String   @id @default(cuid())
  artikelNr  String   @unique
  ean        String?
  product    String
  maat       String?
  inkoopIncl Decimal  @db.Decimal(6, 2)
  webPrijs   Decimal  @db.Decimal(6, 2)
  clubPrijs  Decimal  @db.Decimal(6, 2)
  voorraad   Int      @default(0)
  actief     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model InventoryMove {
  id         String   @id @default(cuid())
  artikelNr  String
  product    String
  maat       String?
  soort      String   // VERKOOP | INKOOP | CORRECTIE
  aantal     Int      // positief = erbij, negatief = eraf
  prijs      Decimal  @db.Decimal(6, 2)
  memberId   String?
  memberNaam String?
  periode    String?
  reden      String?
  createdAt  DateTime @default(now())

  @@index([artikelNr])
  @@index([createdAt])
}
